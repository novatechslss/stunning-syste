# ---- Required (server-side only; never prefix with VITE_) ----
MEDIA_GITHUB_OWNER=your-github-username
MEDIA_GITHUB_REPO=your-media-repo
MEDIA_GITHUB_BRANCH=main
MEDIA_GITHUB_TOKEN=github_pat_REPLACE_ME

# "public" or "private". Must match the real visibility of the GitHub repo.
# public  -> uploads get a raw.githubusercontent.com link
# private -> no public link is created (GitHub raw links need auth)
MEDIA_REPO_VISIBILITY=public

# ---- Optional ----
# Public URL prefix if you front the repo with your own CDN (https only, no trailing slash)
# MEDIA_PUBLIC_BASE_URL=
# Max upload size in MB. Vercel caps request bodies at ~4.5 MB, so values above 4.4 are clamped on Vercel.
MEDIA_MAX_UPLOAD_MB=4
MEDIA_ALLOWED_TYPES=jpg,jpeg,png,webp,gif,mp4,webm,mov

# Emergency switch: true disables ALL uploads (website and API)
MEDIA_UPLOADS_DISABLED=false

# Bot API keys: comma-separated  keyId:sha256hex  (hashes only, never raw keys). Run: npm run generate-key -- mybot
MEDIA_API_KEYS=

# Rate limits (best-effort, per server instance - see README)
MEDIA_RATE_WINDOW_MIN=60
MEDIA_WEB_RATE_LIMIT=10
MEDIA_API_RATE_LIMIT=120
MEDIA_GLOBAL_DAILY_LIMIT=500

# Public browsing (all default to false)
MEDIA_ENABLE_PUBLIC_LIST=false
MEDIA_ENABLE_PUBLIC_LOOKUP=false
MEDIA_ENABLE_DELETE=false

# Extra browser origins allowed to call the API (comma-separated). Same-origin needs nothing.
# MEDIA_ALLOWED_ORIGINS=https://example.com
# MEDIA_SERVER_URL=https://your-project.vercel.app
# MEDIA_TRUSTED_PROXY=vercel   (auto-set on Vercel; use "none" elsewhere)
